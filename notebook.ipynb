   "source": [
    "import sqlite3\n",
    "\n",
    "# verificando se os nomes dos arquivos de cache foram salvos no banco\n",
    "\n",
    "bd_path = \".intpy/intpy.db\"\n",
    "\n",
    "conn: sqlite3.Connection = sqlite3.connect(bd_path)\n",
    "\n",
    "cursor = conn.execute(\"SELECT * FROM CACHE\")\n",
    "\n",
    "for res in cursor.fetchall():\n",
    "    print(res)\n"
   ]
